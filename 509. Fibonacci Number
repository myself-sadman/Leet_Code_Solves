class Solution {
public:
    int fib(int n) {
          int sum=0;
        if(n<1){
            return sum;
        }
        if(n==1){
            sum=1;
            return sum;
        }
        int a=0;
        int b=1;
      
        for(int i=2;i<=n;i++){
            sum=a+b;
            a=b;
            b=sum;
        }
        return sum;
    }
};
